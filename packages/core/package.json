{
  "name": "@dashcommerce/core",
  "version": "0.1.4",
  "description": "DashCommerce — full WooCommerce-equivalent commerce plugin for EmDash CMS",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandbox": {
      "import": "./dist/sandbox-entry.js",
      "types": "./dist/sandbox-entry.d.ts"
    },
    "./admin": {
      "import": "./dist/admin/entry.js",
      "types": "./dist/admin/entry.d.ts"
    },
    "./astro": "./src/astro/index.ts",
    "./astro/components/*": "./src/astro/components/*",
    "./astro/islands/*": "./src/astro/islands/*"
  },
  "files": [
    "dist",
    "src/astro",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "cms",
    "commerce",
    "ecommerce",
    "stripe",
    "woocommerce",
    "shopify",
    "subscriptions",
    "marketplace"
  ],
  "author": "DashCommerce contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdashCommerce/dashcommerce.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/emdashCommerce/dashcommerce/issues"
  },
  "homepage": "https://dashcommerce.dev",
  "bin": {
    "dashcommerce-merge-seed": "./dist/cli/merge-seed.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "emdash": ">=0.28.0 <0.29.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emdash-cms/admin": "^0.28.1",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "emdash": "^0.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
