{
	"name": "@dashcommerce/lite",
	"version": "0.2.0",
	"private": true,
	"description": "DashCommerce for the EmDash plugin registry (sandboxed): products from content, token cart, Stripe hosted Checkout, stock ledger, order admin.",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./storefront": {
			"types": "./storefront/dashcommerce.d.ts",
			"import": "./storefront/dashcommerce.js"
		}
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"icon.png",
		"storefront",
		"README.md",
		"DESIGN.md",
		"PUBLISHING.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emdashCommerce/dashcommerce.git",
		"directory": "packages/lite"
	},
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"bundle": "emdash-plugin bundle",
		"size": "bun scripts/check-size.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/unit",
		"test:sandbox": "vitest run"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0 <2.0.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.3.1",
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "0.2.10",
		"emdash": "1.3.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.0",
		"vitest": "^4.1.0"
	}
}
