{
	"name": "@dashcommerce/paystack",
	"version": "0.1.0",
	"private": true,
	"description": "Paystack PaymentProvider for @dashcommerce/core: hosted checkout (card and M-Pesa), HMAC-SHA512 webhook verification, live status checks and refunds.",
	"type": "module",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./checkout-client": {
			"import": "./dist/checkout-client.mjs",
			"types": "./dist/checkout-client.d.mts"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"keywords": ["dashcommerce", "paystack", "payments", "mpesa", "kenya", "africa"],
	"author": "Fikanova Limited",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"@dashcommerce/core": "workspace:*"
	},
	"devDependencies": {
		"@dashcommerce/core": "workspace:*",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.3"
	}
}
