{
	"name": "@dashcommerce/registry-setup",
	"version": "0.1.1",
	"private": true,
	"description": "DashCommerce setup guide for the EmDash plugin registry (sandboxed). Not published to npm.",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
