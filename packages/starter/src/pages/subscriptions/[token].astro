---
import Shop from "../../layouts/Shop.astro";
import { SANDBOXED } from "../../lib/edition";
import SubscriptionPortal from "@dashcommerce/core/astro/components/SubscriptionPortal.astro";

export const prerender = false;

const { token } = Astro.params;

// Core-only feature: not available in the sandboxed edition.
if (SANDBOXED) return new Response("Not found", { status: 404 });
---
<Shop title="Your subscription">
	<div class="container-narrow" style="padding: 2rem 0;">
		<SubscriptionPortal token={token ?? ""} />
	</div>
</Shop>
