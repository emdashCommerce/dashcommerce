---
import Shop from "../../layouts/Shop.astro";
import { SANDBOXED } from "../../lib/edition";
import OrderSummary from "@dashcommerce/core/astro/components/OrderSummary.astro";

export const prerender = false;

const { draft } = Astro.params;

// Core-only feature: not available in the sandboxed edition.
if (SANDBOXED) return new Response("Not found", { status: 404 });
---
<Shop title="Thank you">
	<OrderSummary orderDraftId={draft ?? ""} />
	<p style="text-align: center; margin-top: 2rem;">
		<a href="/shop">← Back to shop</a>
	</p>
</Shop>
